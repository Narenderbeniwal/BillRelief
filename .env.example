# Database — Neon: use BOTH strings from console.neon.tech → Connect
#
# Pooled (host contains "-pooler") — app + Prisma client (WebSocket driver uses this)
# Must include pgbouncer=true for the pooler:
# DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30"
#
# Direct (same user/db, host WITHOUT "-pooler") — prisma db push / migrate only
# DIRECT_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
#
# Troubleshooting: docs/DATABASE_CONNECTION.md  |  Test: npm run db:ping
DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:pass@host:5432/dbname?schema=public"
# Neon passwordless CLI: psql -h pg.neon.tech

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# PayPal — Payments are received by the PayPal account that owns the App.
# Create an App at https://developer.paypal.com and log in with the account
# that should receive payments (e.g. narenderbeniwal1234@gmail.com).
# Use the App's Client ID and Secret below.
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-client-id"
# Use "sandbox" for testing, "live" for real payments
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_MODE=sandbox

# OpenAI — bill analysis (dashboard) + BillBot site chat widget (gpt-4o)
OPENAI_API_KEY="sk-proj-..."

# BillBot “Talk with a human” form → email (inbox defaults to contact@billreliefai.com from site config)
# Option A — Resend (https://resend.com): verify your domain, then:
# RESEND_API_KEY="re_..."
# MAIL_FROM="BillRelief <noreply@yourdomain.com>"
# SUPPORT_INBOX_EMAIL="contact@billreliefai.com"
#
# Option B — SMTP (Gmail app password, SendGrid, Microsoft 365, etc.):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your@gmail.com"
# SMTP_PASSWORD="app-password"
# MAIL_FROM="BillRelief <your@gmail.com>"
# SUPPORT_INBOX_EMAIL="contact@billreliefai.com"

# Optional: AI (blog readability)
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: Azure Blob Storage for uploads (recommended when deploying to Azure)
# When set, bill uploads go to Blob Storage instead of local disk. Get from Azure Portal → Storage account → Access keys.
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
# Container name (default: bill-uploads). Create this container in the storage account.
# AZURE_STORAGE_CONTAINER_NAME=bill-uploads
